with "config/adsb_radar_config.gpr";
with "config/stm32_hal_config.gpr";

project Adsb_Radar is

   for Target use "arm-eabi";

   Runtime_Device := "";
   case stm32_hal_config.DEVICE is
      when "stm32f407xx" =>
         Runtime_Device := "stm32f4";
      when "stm32f429" =>
         Runtime_Device := "stm32f429disco";
      when "stm32f746" =>
         Runtime_Device := "stm32f746disco";
   end case;
   for Runtime ("Ada") use "embedded-" & Runtime_Device;

   --  src/** = src/ and every folder below it (adsbee, map, sdcard, ui,
   --  nav, debug, system), so a new folder needs no change here
   for Source_Dirs use ("src/**", "config/");
   for Object_Dir use "obj/" & Adsb_Radar_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("adsb_radar.adb");

   package Compiler is
      for Default_Switches ("Ada") use Adsb_Radar_Config.Ada_Compiler_Switches;
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use ("-Wl,--defsym=__stack_size=16384");
   end Linker;

   package Binder is
      --  -Es: symbolic traceback.
      --  -D16k: secondary stack (results of functions returning String,
      --  string concatenation) for the main program
      for Switches ("Ada") use ("-Es", "-D16k");
   end Binder;

end Adsb_Radar;
